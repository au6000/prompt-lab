{
 "format": 2,
 "name": "synthetic-alerts",
 "rows": {"file": "rows.jsonl", "id": "id", "time": "t", "outcome": "label", "value": "value", "state": "state"},
 "outcome": {"classes": ["0", "1"],
             "meaning": {"1": "the alert failed: taking it lost 50", "0": "the alert worked: taking it won 2"}},
 "splits": {"train": ["2018-01-01", "2022-01-01"], "eval": ["2022-01-01", "2024-01-01"], "test": ["2024-01-01", "2026-01-01"]},
 "cv_groups": "month",
 "half_boundary": "2020-01-01",
 "train_sample": {"reference_per_other": 6, "seed": 12345},
 "decision": {"skip_if_prob_at_least": 0.5},
 "state_fields": "all",
 "field_groups": {},
 "rule_frame": {
  "head": "These are the trader's veto rules (reasons not to take an alert). If at least one of them applies to this alert, the trader skips it; if none of them applies, the trader takes it. Apply the rules to the numbers given. ",
  "tail": " Following these rules, should this alert be skipped?"
 },
 "selection": {
  "require": [
   {"metric": "train.cv_gain_pct", "op": ">", "value": 0},
   {"metric": "eval.cv_gain_pct", "op": ">", "value": 0},
   {"metric": "eval.null_pct.cv_gain_pct", "op": ">=", "value": 90},
   {"metric": "eval.decision.gain_vs_all_in_per_1000", "op": ">", "value": 0}
  ],
  "rank_by": [{"metric": "eval.decision.gain_vs_all_in_per_1000", "order": "desc"},
              {"metric": "eval.decision.skip_frac", "order": "asc"}]
 },
 "budget": {"usd": 0.5, "eval_checks_per_agent": 4, "nominations_per_agent": 2},
 "deciders": {"jev": {"kind": "gateway", "model": "typesafe-ai/jev", "price_per_mtok": 0.042},
              "fake": {"kind": "fake", "cost_per_call": 0.0}},
 "decider": "fake",
 "gateway": {"workers": 6, "retries": 4, "timeout_s": 120},
 "metrics": {"cv_folds": 10, "cv_reps": 3, "mi_perms": 500, "null_reps": 200, "null_seed": 777}
}
